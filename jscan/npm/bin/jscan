#!/usr/bin/env node

// jscan has merged into polyscan. This package is a thin wrapper that runs
// the polyscan CLI so that existing `npx jscan` invocations keep working
// while users migrate. https://github.com/ludo-technologies/polyscan

const { spawn } = require("child_process");
const os = require("os");

process.stderr.write(
  "jscan is deprecated: it has merged into polyscan.\n" +
    "Run `npx polyscan analyze .` instead — the same JavaScript/TypeScript\n" +
    "analysis, plus Go, Rust and C++. https://github.com/ludo-technologies/polyscan\n\n"
);

const args = process.argv.slice(2);

// Commands of the retired jscan CLI that polyscan does not have. Exit code 2
// keeps jscan's convention of "could not run", as opposed to a failed gate.
const retired = {
  check:
    "gate on `polyscan analyze --format json` output in CI instead.",
  deps: "run `polyscan analyze --select deps` for dependency analysis.",
  init: "polyscan still reads jscan.config.json when present; write it by hand.",
};

if (args.length > 0 && Object.prototype.hasOwnProperty.call(retired, args[0])) {
  console.error(
    `jscan ${args[0]} was retired when jscan merged into polyscan; ` +
      retired[args[0]]
  );
  process.exit(2);
}

// Flags of the retired jscan `analyze` that polyscan spells differently, so
// that an existing `npx jscan analyze --json` keeps producing JSON.
const formatShorthands = { "--json": "json", "--text": "text", "--html": "html" };

function translateAnalyzeFlags(args) {
  const out = [];
  for (const arg of args) {
    if (Object.prototype.hasOwnProperty.call(formatShorthands, arg)) {
      out.push("--format", formatShorthands[arg]);
    } else if (arg === "-c" || arg === "--config" || arg.startsWith("--config=")) {
      console.error(
        "jscan analyze --config was retired when jscan merged into polyscan; " +
          "polyscan finds jscan.config.json by searching upward from the analyzed path."
      );
      process.exit(2);
    } else {
      out.push(arg);
    }
  }
  return out;
}

const forwarded = args[0] === "analyze" ? translateAnalyzeFlags(args) : args;

let launcher;
try {
  launcher = require.resolve("polyscan/bin/polyscan");
} catch {
  console.error(
    "Could not find the polyscan package that jscan now wraps.\n" +
      "Try reinstalling: npm install jscan"
  );
  process.exit(1);
}

const child = spawn(process.execPath, [launcher, ...forwarded], {
  stdio: "inherit",
});

child.on("error", (err) => {
  console.error(`Failed to start polyscan: ${err.message}`);
  process.exit(1);
});

child.on("close", (code, signal) => {
  // A signal-terminated scan (OOM kill, SIGPIPE) reports no exit code, so
  // map the signal to the shell convention of 128 + signal number.
  process.exit(signal ? 128 + os.constants.signals[signal] : code);
});
