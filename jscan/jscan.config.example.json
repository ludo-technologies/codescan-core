{
  "complexity": {
    "low_threshold": 10,
    "medium_threshold": 20,
    "max_complexity": 0,
    "report_unchanged": false
  },
  "dead_code": {
    "min_severity": "info",
    "sort_by": "severity"
  },
  "output": {
    "sort_by": "complexity",
    "min_complexity": 1
  },
  "analysis": {
    "include_patterns": [
      "**/*.js",
      "**/*.jsx",
      "**/*.ts",
      "**/*.tsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude_patterns": [
      "node_modules",
      "dist",
      "build",
      "*.min.js",
      "*.bundle.js"
    ],
    "recursive": true
  }
}
