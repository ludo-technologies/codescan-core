#!/usr/bin/env node

const { spawn } = require("child_process");
const os = require("os");

const platformPackages = {
  "darwin-arm64": "polyscan-darwin-arm64",
  "linux-x64": "polyscan-linux-x64",
  "linux-arm64": "polyscan-linux-arm64",
  "win32-x64": "polyscan-windows-x64",
};

const key = `${process.platform}-${process.arch}`;
const pkg = platformPackages[key];

if (!pkg) {
  console.error(
    `Unsupported platform: ${process.platform}-${process.arch}\n` +
      `polyscan supports: ${Object.keys(platformPackages).join(", ")}`
  );
  process.exit(1);
}

const ext = process.platform === "win32" ? ".exe" : "";
let binaryPath;
try {
  binaryPath = require.resolve(`${pkg}/bin/polyscan${ext}`);
} catch {
  console.error(
    `Could not find the polyscan binary for ${process.platform}-${process.arch}.\n` +
      `The platform package "${pkg}" may not be installed.\n` +
      `Try reinstalling: npm install polyscan`
  );
  process.exit(1);
}

const child = spawn(binaryPath, process.argv.slice(2), {
  stdio: "inherit",
});

child.on("error", (err) => {
  console.error(`Failed to start polyscan: ${err.message}`);
  process.exit(1);
});

child.on("close", (code, signal) => {
  // A signal-terminated scan (OOM kill, SIGPIPE) reports no exit code, so
  // map the signal to the shell convention of 128 + signal number.
  process.exit(signal ? 128 + os.constants.signals[signal] : code);
});
